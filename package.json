{
  "name": "ZFI_ODATA",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "axios": "^1.21.0",
    "soap": "^1.14.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "node --inspect=127.0.0.1:9229 node_modules/@sap/cds/bin/serve.js",
    "watch-fi-journal-entries": "cds watch --open fijournalentries/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "JournalEntryPost": {
        "kind": "SOAP",
        "credentials": {
          "destination": "S4HANA_ONPREM",
          "path": "http://vd4l.sap.internal:50100/sap/bc/srt/xip/sap/journalentrycreaterequestconfi/400/journalentrypost/journalentrypostbinding"
        }
      },
      "D4L": {
        "kind": "odata-v2",
        "model": "srv/external/D4L",
        "credentials": {
          "destination": "D4L",
          "path": "/sap/opu/odata/sap/API_JOURNALENTRYITEMBASIC_SRV"
        },
        "csrf": false,
        "csrfInBatch": false
      },
      "destination": {
        "kind": "destination"
      },
      "connectivity": {
        "kind": "connectivity"
      },
      "[production]": {
        "auth": "xsuaa",
        "connectivity": true,
        "destinations": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/fi-journal-entries"
  ]
}
